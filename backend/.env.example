# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# CORS Configuration (comma-separated list of allowed origins)
# For local frontend development (Vite / React default ports)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ML Artifact Paths (relative to backend directory or absolute paths)
# Defaults resolve automatically to ../ml/{models,schemas,metadata}
MODELS_DIR=../ml/models
SCHEMAS_DIR=../ml/schemas
METADATA_DIR=../ml/metadata

# Note: Production decision thresholds (Cost: 0.40, Delay: 0.50) are locked
# production constants sourced directly from ml/metadata/model_metadata.json
# and ml/schemas/inference_output_schema.json, and are not user-configurable.
